# Rebuilds an upstream release with a current Go toolchain. Same build as the
# upstream distroless image (static, -tags json1) on the same runtime base as
# Dockerfile-distroless-static; Renovate moves both pins.
FROM --platform=$BUILDPLATFORM golang:1.26.11@sha256:957952ae74dc010608717144399a59a2c6e82ea03d63be1c7ff6577c5a135f93 AS build

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -mod=readonly -buildvcs=false -tags json1 \
    -ldflags "-s -w \
      -X github.com/ory/hydra/v2/driver/config.Version=$VERSION \
      -X github.com/ory/hydra/v2/driver/config.Commit=$COMMIT \
      -X github.com/ory/hydra/v2/driver/config.Date=$DATE" \
    -o /hydra .

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

COPY --from=build /hydra /usr/bin/hydra
# 4444 is the public endpoint, 4445 the admin endpoint.
EXPOSE 4444 4445

ENTRYPOINT ["hydra"]
CMD ["serve", "all"]
